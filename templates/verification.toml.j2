schema_version = "1.4"
multi_step_reward_strategy = "final"

[task]
name = {{ ("local-eval-verification/" + task.task_id) | tojson }}
description = {{ ("Fresh verification of " + task.model + ": " + task.workload) | tojson }}

[environment]
build_timeout_sec = {{ config.evaluation.install_timeout_seconds }}
cpus = {{ config.environment.cpus }}
memory_mb = {{ config.environment.memory_mb }}
{% if config.environment.provider != "docker" %}
storage_mb = {{ config.environment.storage_mb }}
{% if "gpus" in config.environment.kwargs %}
gpus = {{ config.environment.kwargs.gpus }}
{% endif %}
{% if "gpu_types" in config.environment.kwargs %}
gpu_types = {{ config.environment.kwargs.gpu_types | tojson }}
{% endif %}
{% endif %}
workdir = "/workspace"

[environment.healthcheck]
command = "test -f /run/eval-ready"
interval_sec = 2
timeout_sec = 2
start_period_sec = {{ config.evaluation.health_timeout_seconds }}
retries = 1

[verifier]
environment_mode = "shared"
user = "root"
timeout_sec = 172800

[[steps]]
name = "prepare"
min_reward = 1

[steps.agent]
user = "root"
timeout_sec = 60

[steps.verifier]
environment_mode = "shared"
user = "root"
timeout_sec = {{ config.evaluation.install_timeout_seconds * 2 + 600 }}

[[steps]]
name = "review"
min_reward = 1
artifacts = ["/workspace/.harbor/reviewer-history"]

[steps.agent]
user = "judge"
timeout_sec = 60

[steps.verifier]
environment_mode = "shared"
user = "judge"
timeout_sec = {{ config.evaluation.agent.budget_seconds + 120 }}

[steps.verifier.env]
{% for name, value in review_env.items() %}
{{ name }} = {{ value | tojson }}
{% endfor %}
{% if config.evaluation.agent.name == "claude-code" and config.evaluation.agent.kwargs.get("reasoning_effort") %}
CLAUDE_CODE_EFFORT_LEVEL = {{ config.evaluation.agent.kwargs.reasoning_effort | tojson }}
{% endif %}

[[steps]]
name = "quality"
min_reward = 1

[steps.agent]
user = "root"
timeout_sec = 60

[steps.verifier]
environment_mode = "shared"
user = "root"
network_mode = "no-network"
# Quality has its own deadline; allow startup and bounded cleanup outside it.
timeout_sec = {{ config.evaluation.quality_timeout_seconds + config.evaluation.health_timeout_seconds + 120 }}
{% if task.type == "SLO" %}

[[steps]]
name = "slo"

[steps.agent]
user = "root"
timeout_sec = 60

[steps.verifier]
environment_mode = "shared"
user = "root"
network_mode = "no-network"
# Each repeat: startup, one warmup bounded at 300 s, then the SLO budget.
timeout_sec = {{ (config.evaluation.slo_budget_seconds + config.evaluation.health_timeout_seconds + 300 + config.evaluation.slo_request_cap_seconds) * config.evaluation.slo_repeats + 3600 }}
{% else %}

[[steps]]
name = "reference-prepare"
min_reward = 1

[steps.agent]
user = "root"
timeout_sec = 60

[steps.verifier]
environment_mode = "shared"
user = "root"
timeout_sec = {{ config.evaluation.install_timeout_seconds + 600 }}

[[steps]]
name = "reference"
min_reward = 1

[steps.agent]
user = "root"
timeout_sec = 60

[steps.verifier]
environment_mode = "shared"
user = "root"
network_mode = "no-network"
timeout_sec = 172800

[[steps]]
name = "measure"

[steps.agent]
user = "root"
timeout_sec = 60

[steps.verifier]
environment_mode = "shared"
user = "root"
network_mode = "no-network"
timeout_sec = 172800
{% endif %}
