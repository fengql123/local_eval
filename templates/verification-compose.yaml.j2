services:
  main:
    image: {{ image.tag | tojson }}
    user: root
    security_opt: ["no-new-privileges:true"]
    cap_add: [NET_ADMIN]
    init: true
    working_dir: /workspace
    command: ["bash", "/opt/eval/start.sh"]
    healthcheck:
      test: ["CMD", "test", "-f", "/run/eval-ready"]
      interval: 2s
      timeout: 2s
      start_period: {{ config.evaluation.health_timeout_seconds }}s
      retries: 1
    volumes: {{ verification_mounts | tojson }}
{% if gpu_ids %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: {{ gpu_ids | tojson }}
              capabilities: [gpu]
{% endif %}
