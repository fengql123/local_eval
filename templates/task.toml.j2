schema_version = "1.4"
artifacts = {{ (["/var/lib/local-eval/reference"] if phase == "search" else ["/var/lib/local-eval/submission"]) | tojson }}

[task]
name = {{ ("local-eval-" + phase + "/" + task.task_id) | tojson }}
description = {{ (phase | capitalize + " for " + task.model + ": " + task.workload) | tojson }}

[environment]
build_timeout_sec = {{ config.evaluation.install_timeout_seconds }}
cpus = {{ config.environment.cpus }}
memory_mb = {{ config.environment.memory_mb }}
{% if config.environment.provider != "docker" %}
storage_mb = {{ config.environment.storage_mb }}
{% if "gpus" in config.environment.kwargs %}
gpus = {{ config.environment.kwargs.gpus }}
{% endif %}
{% if "gpu_types" in config.environment.kwargs %}
gpu_types = {{ config.environment.kwargs.gpu_types | tojson }}
{% endif %}
{% endif %}
workdir = "/workspace"

[environment.healthcheck]
command = "test -f /run/eval-ready"
interval_sec = 2
timeout_sec = 2
start_period_sec = {{ config.evaluation.health_timeout_seconds }}
retries = 1

[agent]
user = {{ ("search" if phase == "search" else "agent") | tojson }}
timeout_sec = {{ config.search.agent.budget_seconds if phase == "search" else (config.agent.budget_seconds if config.agent else 7200) }}

[verifier]
environment_mode = "shared"
# Trusted handoff checks have no agent execution or submitted installation.
user = "root"
timeout_sec = 600

[[verifier.collect]]
{% if phase == "coding" %}
command = "/opt/eval/.venv/bin/python -I -m eval.verify.run --collect-submission"
{% else %}
command = "/opt/eval/.venv/bin/python -I -m eval.search.run --task /var/lib/local-eval/task.json --stage collect"
{% endif %}
user = "root"
timeout_sec = 60
