schema_version = "1.4"
multi_step_reward_strategy = "final"

[task]
name = {{ ("local-eval/" + task.task_id) | tojson }}
description = {{ (task.model + " serving benchmark: " + task.workload) | tojson }}

[environment]
build_timeout_sec = {{ config.evaluation.install_timeout_seconds }}
cpus = {{ machine.cpu_cores }}
memory_mb = {{ machine.memory_bytes // 1048576 }}
gpus = {{ machine.gpus | length }}
workdir = "/workspace"

[environment.healthcheck]
command = "test -f /run/eval-ready"
interval_sec = 2
timeout_sec = 2
start_period_sec = {{ config.evaluation.health_timeout_seconds }}
retries = 1

[verifier]
environment_mode = "shared"
user = "root"
timeout_sec = 172800

[[steps]]
name = "search"
min_reward = 1

[steps.agent]
user = "search"
timeout_sec = {{ config.search.agent.budget_seconds }}

[steps.verifier]
environment_mode = "shared"
user = "root"
timeout_sec = 600

[[steps]]
name = "coding"

[steps.agent]
user = "agent"
timeout_sec = {{ config.agent.budget_seconds if config.agent else 7200 }}

[steps.verifier]
environment_mode = "shared"
user = "root"
timeout_sec = 172800
