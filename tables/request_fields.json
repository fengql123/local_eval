{
  "apis": {
    "openai-chat": {
      "endpoint": "/v1/chat/completions",
      "stream": {
        "stream": true,
        "stream_options": {
          "include_usage": true
        }
      },
      "max_tokens": "max_tokens",
      "output_count": "usage.completion_tokens",
      "force": {
        "ignore_eos": true
      }
    },
    "ollama-chat": {
      "endpoint": "/api/chat",
      "stream": {
        "stream": true
      },
      "max_tokens": "options.num_predict",
      "output_count": "eval_count",
      "force": {}
    }
  },
  "baselines": {
    "candidate": {
      "api": "openai-chat",
      "status": "authored-policy",
      "note": "Authored evaluator request policy. Engine compatibility is accepted in Phase 6."
    },
    "freetoken": {
      "api": "openai-chat",
      "status": "authored-unverified",
      "note": "Category install scripts and request fields require actual engine acceptance in Phase 6."
    },
    "llama.cpp": {
      "api": "openai-chat",
      "status": "authored-unverified",
      "note": "Category install scripts and request fields require actual engine acceptance in Phase 6."
    },
    "ktransformers": {
      "api": "openai-chat",
      "status": "authored-unverified",
      "note": "Category install scripts and request fields require actual engine acceptance in Phase 6."
    },
    "ktransformers-dsv4": {
      "api": "openai-chat",
      "status": "authored-unverified",
      "note": "Category install scripts and request fields require actual engine acceptance in Phase 6."
    },
    "ollama": {
      "api": "ollama-chat",
      "status": "unsupported-agentic",
      "note": "Native Ollama has no ignore_eos or full chat_template_kwargs pass-through. Exact agentic count and full template-policy compatibility remain unsupported."
    },
    "mlx-serve": {
      "api": "openai-chat",
      "status": "planned",
      "note": "No supplied category installation script yet; retained as catalog intent."
    },
    "lm-studio": {
      "api": "openai-chat",
      "status": "planned",
      "note": "No supplied category installation script yet; retained as catalog intent."
    }
  },
  "models": {
